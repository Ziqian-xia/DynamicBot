# .env.example — copy to backend/.env and fill in your values.
# The actual .env file is git-ignored and must never be committed.

# ── REQUIRED ────────────────────────────────────────────────────────────────

# Your OpenAI API key (starts with sk-).
# Get one at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...your-key-here...

# ── RECOMMENDED ─────────────────────────────────────────────────────────────

# Password for the /admin panel.
# If not set, a random key is auto-generated and printed to startup logs only.
# Generate a secure value: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=

# ── RAILWAY DEPLOYMENT ───────────────────────────────────────────────────────

# Path for the SQLite database.
# Railway: set to /data and attach a Volume mounted at /data in the dashboard.
# Local dev: leave unset (defaults to the backend/ directory).
DATA_DIR=/data

# ── OPTIONAL ─────────────────────────────────────────────────────────────────

# Set to "true" ONLY during local widget development (allows file:// origin).
# Must be "false" or unset in production.
ALLOW_NULL_ORIGIN=false
